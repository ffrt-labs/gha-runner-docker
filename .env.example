# Set exactly one of GITHUB_ORG or GITHUB_REPO.
# GITHUB_ORG registers an org-wide runner; the token needs admin:org.
GITHUB_ORG=
# GITHUB_REPO (owner/repo) registers a runner to that single repo; the token
# needs repo scope (fine-grained: Administration read/write on that repo).
GITHUB_REPO=
GITHUB_TOKEN=
RUNNER_NAME=
RUNNER_LABELS=

# Running a second runner (e.g. repo-level) alongside the org one: copy this
# file to .env.<name>, set GITHUB_REPO and a distinct RUNNER_NAME, then
# point ENV_FILE at it and give it its own _work dir (the runner wipes
# _work/_temp each job, so two runners can't share one). The work dir must be
# owned by the same uid as /actions-runner/_work.
#   ENV_FILE=.env.backlog RUNNER_WORK_DIR=/actions-runner/_work-backlog \
#     docker compose -p runner-backlog --env-file .env.backlog up -d
ENV_FILE=
RUNNER_WORK_DIR=
